# 本机密钥和模型连接配置，绝不提交到 Git。
.env

# Python 自动生成的缓存文件。
__pycache__/
*.py[cod]

# 当前项目的 Python 虚拟环境，可随时根据 requirements.txt 重建。
.venv/

# 本地会话数据库及 SQLite 自动生成的辅助文件。
/data/memory.db
/data/memory.db-wal
/data/memory.db-shm
/data/memory.db-journal

# 本地向量模型下载缓存，可重新下载，不提交到 Git。
/data/embedding_models/

# V3 历史快照独立运行时生成的会话数据库。
/versions/v3/data/memory.db
/versions/v3/data/memory.db-wal
/versions/v3/data/memory.db-shm
/versions/v3/data/memory.db-journal

